{
  "name": "slidev-theme-tufte",
  "version": "0.1.1",
  "description": "Slidev theme after Edward Tufte: show the data, maximise data-ink, no chartjunk",
  "author": "Christoph Martel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abits/slidev-theme-tufte.git"
  },
  "keywords": [
    "slidev-theme",
    "slidev",
    "tufte",
    "presentation",
    "slides",
    "data-visualization",
    "sparkline"
  ],
  "engines": {
    "slidev": ">=52.0.0"
  },
  "files": [
    "components",
    "layouts",
    "setup",
    "styles"
  ],
  "scripts": {
    "dev": "slidev example.md",
    "build": "slidev build example.md",
    "export": "slidev export example.md --per-slide",
    "screenshot": "slidev export example.md --format png --output screenshots"
  },
  "devDependencies": {
    "@slidev/cli": "53.1.0",
    "playwright-chromium": "1.65.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "fonts": {
        "sans": "TeX Gyre Pagella",
        "serif": "TeX Gyre Pagella",
        "mono": "DejaVu Sans Mono",
        "provider": "none"
      },
      "transition": "none",
      "aspectRatio": "16/9",
      "canvasWidth": 980
    }
  },
  "homepage": "https://github.com/abits/slidev-theme-tufte#readme",
  "bugs": {
    "url": "https://github.com/abits/slidev-theme-tufte/issues"
  }
}
